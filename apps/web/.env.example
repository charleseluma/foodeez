# Copy to .env.local for local development. In AWS Amplify, add these as
# environment variables instead (App settings → Environment variables).
# Both are public by design; never add the Supabase secret / service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
